# =============================================================================
# FarmLink — environment variables (copy to .env and fill for local dev)
# Demos run safely with defaults: real external credentials are NEVER required.
# =============================================================================

# ---- General -----------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
TZ=Asia/Kolkata
LOG_LEVEL=info
LOG_PRETTY=true
API_PORT=4000
API_PREFIX=/api/v1
API_PUBLIC_URL=http://localhost:4000/api/v1
WEB_PUBLIC_URL=http://localhost:3000

# Comma separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Space-separated list of allowed upload MIME extensions (see uploads module).
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp,image/heic,application/pdf

# ---- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgresql://farmlink:farmlink_dev_password@localhost:5432/farmlink?schema=public
# Optional separate URL for migrations when reading replicas exist.
DIRECT_URL=

# ---- Redis ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=farmlink:

# ---- Auth & session ------------------------------------------------------------
# 32+ character secret generating session JWT. Change in ANY non-local env.
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-min
SESSION_TTL_SECONDS=604800
# Demo OTP: when AUTH_OTP_PROVIDER=mock the code is always the configured value
AUTH_OTP_PROVIDER=mock
MOCK_OTP_CODE=123456
# e.g. AUTH_OTP_PROVIDER=twilio + real credentials (disabled by default)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Cookie security (Secure=true is forced when APP_ENV!=local)
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ---- CSRF -----------------------------------------------------------------------
CSRF_COOKIE_NAME=_farmlink_csrf
CSRF_URL_SAFE_LENGTH=32

# ---- Object storage (S3-compatible). Storage options: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage-local
# S3 provider remains disabled unless STORAGE_DRIVER=s3 and creds are set
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_EXPIRES_SECONDS=900
S3_DOWNLOAD_EXPIRES_SECONDS=3600
S3_KMS_KEY_ID=

# ---- Map provider (deterministic local mock by default) -----------------------
MAPS_PROVIDER=mock

# ---- Market data / price feeds -------------------------------------------------
MARKET_DATA_PROVIDER=mock
MANDI_API_KEY=

# ---- Payments ------------------------------------------------------------------
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Telephony / IVR ------------------------------------------------------------
TELEPHONY_PROVIDER=mock
IVR_TOLL_FREE_NUMBER=1800-000-1111

# ---- ONDC -----------------------------------------------------------------------
ONDC_PROVIDER=mock
ONDC_SUBSCRIBER_ID=
ONDC_SUBSCRIBER_UNIQUE_KEY_ID=
ONDC_PRIVATE_KEY=
ONDC_ENCRYPTION_KEY=

# ---- Finance / e-NWR partner ------------------------------------------------------
FINANCE_PROVIDER=mock
FINANCE_PARTNER_WEBHOOK_SECRET=
LENDER_API_BASE_URL=

# ---- Notifications ---------------------------------------------------------------
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FarmLink <no-reply@farmlink.example>

# ---- Webhooks (outbound signature) -------------------------------------------------
WEBHOOK_SIGNING_SECRET=change-me-webhook-signing-secret-min-32-chars
WEBHOOK_TOLERANCE_MS=300000

# ---- Security headers ---------------------------------------------------------------
CSP_DIRECTIVES_DEFAULT_SRC=self
# Comma separated directives overrides (empty = sane defaults applied)

# ---- Observability --------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=farmlink-api
SENTRY_DSN===